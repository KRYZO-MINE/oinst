# OINST — Environment Variables (server-side only)
# ---------------------------------------------------------------
# This key is read ONLY by the serverless function at /api/proxy.js
# It is never shipped to the browser, so it can never leak.
#
# Local dev  : copy this file to `.env.local` and fill the real key.
# Vercel     : Project -> Settings -> Environment Variables -> add
#              OINST_API_KEY = <your_key>  (Production + Preview + Development)
# ---------------------------------------------------------------

OINST_API_KEY=your_api_key_here
